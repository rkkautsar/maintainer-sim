{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maintainer-sim",
  "main": "src/cloudflare/worker.ts",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "GAMES",
        "class_name": "GameSession"
      },
      {
        "name": "BUDGET",
        "class_name": "AIBudget"
      },
      {
        "name": "LAUNCHES",
        "class_name": "LaunchSession"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "GameSession",
        "AIBudget"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "LaunchSession"
      ]
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "JUDGE_ENABLED": "true",
    "REVIEW_COACHING_ENABLED": "true",
    "COACH_CONFIDENCE_THRESHOLD": "0.3",
    "JUDGE_CONFIDENCE_THRESHOLD": "0.2",
    "JUDGE_INPUT_USD_PER_MILLION": "0.038",
    "AI_DAILY_BUDGET_USD": "1",
    "GITHUB_CLIENT_ID": "Iv23liIU7hVd8ynBoZN4",
    "GITHUB_APP_SLUG": "maintainer-sim",
    "PUBLIC_ORIGIN": "https://maintainer-sim.rkkautsar.workers.dev"
  },
  "build": {
    "command": "node scripts/bundle-packages.ts"
  },
  "observability": {
    "enabled": true
  }
}
