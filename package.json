{
  "name": "maintainer-sim",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "check": "tsc --noEmit",
    "demo": "node --env-file-if-exists=.env src/cli.ts demo",
    "start": "node --env-file-if-exists=.env src/cli.ts serve",
    "cli": "node --env-file-if-exists=.env src/cli.ts",
    "cf:dev": "wrangler dev",
    "cf:check": "wrangler deploy --dry-run --outdir var/worker-build",
    "cf:deploy": "wrangler deploy",
    "cf:cli": "node --env-file-if-exists=.env src/cloudflare-cli.ts",
    "test:cf": "npm run cf:check && node --test test/cloudflare/*.test.ts",
    "scenario": "node scripts/scenario.ts",
    "judge:calibrate": "node scripts/calibrate-judge.ts",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@octokit/rest": "^22.0.0",
    "yaml": "2.8.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261014.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.12.0",
    "miniflare": "^4.20260730.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.2",
    "wrangler": "^4.151.0"
  },
  "overrides": {
    "miniflare": {
      "undici": "^7.30.0",
      "sharp": "^0.35.5"
    }
  }
}
