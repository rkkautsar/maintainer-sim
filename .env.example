GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=
WEBHOOK_SECRET=
DATABASE_PATH=var/game.sqlite
PORT=3000
# Jev is disabled unless both variables are supplied.
JEV_API_KEY=
JEV_INPUT_USD_PER_MILLION=
AI_DAILY_BUDGET_USD=1
DISPOSABLE_REPO_CONFIRMED=false
JEV_CALIBRATED=false
JEV_MODEL=jev-1.13.0
JEV_CONFIDENCE_THRESHOLD=0.9
# Launch page OAuth. Store real values only in ignored .env / Worker secrets.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
